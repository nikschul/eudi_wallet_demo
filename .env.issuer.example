# Persoenlicher Issuer: cp .env.issuer.example .env.issuer
# Immer mit -p eudi-issuer --env-file .env.issuer -f compose.issuer.yaml aufrufen.
# APP_ROLE=issuer und Container-Port 3000 setzt Compose fest.
PORT=3001
# Zum Start localhost; danach hier die EIGENE cloudflared-HTTPS-Adresse eintragen.
PUBLIC_URL=http://localhost:3001
# VOR dem ersten Start: zentrale oeffentliche HTTPS-Adresse der Moderation einsetzen.
# Exakter Browser-Origin ohne Unterpfad; NICHT die eigene Issuer-Adresse.
WORKSHOP_URL=
# Eigenes langes Zufallstoken; NIEMALS das Workshop-Admin-Token verwenden.
ADMIN_TOKEN=
# Nur bei direktem Node-Betrieb: eigenes Verzeichnis pro Rolle festlegen.
# DATA_DIR=./data-issuer
