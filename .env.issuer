# Oeffentliche Dummy-Konfiguration, keine Geheimnisse eintragen.
APP_ROLE=issuer
# Host-Port; im Container bleibt PORT=3000.
PORT=3001
# Startwert lokal; nach Tunnelstart durch die EIGENE cloudflared-HTTPS-URL ersetzen.
PUBLIC_URL=http://localhost:3001
# Demo-Adresse: VOR dem Start durch die zentrale HTTPS-URL der Moderation ersetzen.
WORKSHOP_URL=https://workshop-demo.example.invalid
# Die Demo-Verwaltung ist ohne Anmeldung ueber den Tunnel oeffentlich erreichbar.
