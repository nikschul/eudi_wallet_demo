# Host-only configuration. No participant settings, tokens or private keys.
# Published main-branch image; no manual image ID or commit SHA is needed.
DEMO_IMAGE=ghcr.io/nikschul/eudi_wallet_demo:latest
# Host loopback port; the container always listens on port 3000.
PORT=3000
# Local preview only. Replace with the native terminal tunnel's HTTPS origin
# before sharing the app with smartphones. Do not include a path or trailing slash.
PUBLIC_URL=http://localhost:3000
VERIFIER_NAME=Check-In
EVENT_TITLE=Wallet & Check-In
