# Docker Compose liest .env automatisch.
# Lokal: npm run start:env (Node >= 20.6; Node 24 LTS empfohlen).
PORT=3000
# Muss bei einem anderen PORT im lokalen Betrieb ebenfalls angepasst werden.
PUBLIC_URL=http://localhost:3000
TRUST_MODE=auto
# Leer: beim Start zufaellig erzeugt und in der Konsole ausgegeben.
# Fuer Deployment ein festes, langes Zufallstoken ohne Leerzeichen setzen.
ADMIN_TOKEN=
VERIFIER_NAME=Fraunhofer ISST – Empfang
EVENT_TITLE=EUDI Wallet Workshop
# Nur fuer das Compose-Profil "https": oeffentliche Domain mit DNS auf diesen Server.
DOMAIN=wallet.example.org
# Nur fuer direkten Node-Betrieb; Compose verwendet sein benanntes Datenvolume.
# DATA_DIR=/absoluter/pfad/zu/eudi-data
