# Workshop-Zentrale: cp .env.example .env.workshop
# Immer mit -p eudi-workshop --env-file .env.workshop -f compose.yaml aufrufen.
# APP_ROLE=workshop und Container-Port 3000 setzt Compose fest.
PORT=3000
# Zum Start localhost; danach hier die eigene cloudflared-HTTPS-Adresse eintragen.
PUBLIC_URL=http://localhost:3000
# Vor dem Start ein langes zufaelliges Token setzen; niemals als Issuer-Token nutzen.
ADMIN_TOKEN=
VERIFIER_NAME=Fraunhofer ISST – Empfang
EVENT_TITLE=EUDI Wallet Workshop
# Nur bei direktem Node-Betrieb: eigenes Verzeichnis pro Rolle festlegen.
# DATA_DIR=./data-workshop
